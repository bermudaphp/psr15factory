{
  "name": "bermudaphp/psr15factory",
  "description": "Powerful and flexible factory for creating PSR-15 compatible middleware with automatic dependency injection and request data mapping",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "psr-15",
    "middleware",
    "factory",
    "dependency-injection",
    "psr-7",
    "http",
    "request-mapping",
    "middleware-factory",
    "http",
    "middleware-resolver"
    "php84"
  ],
  "require": {
    "php": "^8.4",
    "bermudaphp/config": "^2.0",
    "bermudaphp/pipeline": "^2.1",
    "bermudaphp/container-aware": "^1.0.1",
    "bermudaphp/reflection": "^2.0",
    "bermudaphp/di-resolver": "^1.0",
    "psr/container": "^2.0.2",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Bermuda\\MiddlewareFactory\\": "src/",
      "Bermuda\\MiddlewareFactory\\Adapter\\": "src/adapter/",
      "Bermuda\\MiddlewareFactory\\Attribute\\": "src/attribute/",
      "Bermuda\\MiddlewareFactory\\Resolver\\": "src/resolver/",
      "Bermuda\\MiddlewareFactory\\Strategy\\": "src/strategy/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bermuda\\MiddlewareFactory\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "*": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
